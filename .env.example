# ============================================================
# Scholar AI — Environment Configuration
# ============================================================

# --- App Settings ---
APP_TITLE=Scholar AI
APP_ICON=📚
ENVIRONMENT=development
DEBUG=true

# --- PDF Processing ---
MAX_FILE_SIZE_MB=50

# --- Adaptive Chunking ---
MIN_CHUNK_SIZE=150
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Vector Database ---
TOP_K=10

# --- Binary Search Context Optimizer ---
SIMILARITY_THRESHOLD=0.70
MAX_CONTEXT_TOKENS=1400
MIN_CONTEXT_COVERAGE=0.62

# --- Hybrid Retrieval ---
HYBRID_DENSE_WEIGHT=0.55
HYBRID_BM25_WEIGHT=0.30
HYBRID_KEYWORD_WEIGHT=0.15
RERANK_TOP_N=12

# --- Ollama LLM ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- Confidence ---
MIN_CONFIDENCE=0.50

# --- Research Experiments ---
EXPERIMENT_NAME=Adaptive_RAG_v1
SAVE_RETRIEVAL_LOGS=true
SAVE_RESPONSE_LOGS=true

# --- Performance ---
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL=3600
ENABLE_MODEL_CACHE=true
ENABLE_FAISS_CACHE=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Rate Limiting ---
ENABLE_RATE_LIMITING=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
